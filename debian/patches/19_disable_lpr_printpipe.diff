+++ rxvt-unicode/src/feature.h	2020-04-10 10:10:39.097757946 -0400
@@ -333,7 +333,7 @@
 /*
  * Printer pipe which will be used for emulation of attached vt100 printer
  */
-#define PRINTPIPE	"lpr"
+#define PRINTPIPE	"true"
 
